# Database
DATABASE_URL="postgresql://eventquest:eventquest@localhost:5432/eventquest?schema=public"

# Backend API
API_PORT=3001
NODE_ENV=development

# JWT (organizer authentication)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="7"

# Coordinator access token lifetime (days)
COORDINATOR_ACCESS_EXPIRES_IN_DAYS="30"

# Payments (placeholder provider is the MVP default; set PAYMENTS_PROVIDER=stripe for Stripe)
PAYMENTS_PROVIDER="placeholder"
PAYMENTS_WEBHOOK_SECRET="change-me-payments-webhook-secret"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# PAYMENTS_CHECKOUT_SUCCESS_URL="http://localhost:3000/packages?checkout=success"
# PAYMENTS_CHECKOUT_CANCEL_URL="http://localhost:3000/packages?checkout=cancelled"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
